// Informacoes de versao do peerlive-audio.exe (aparecem em Propriedades > Detalhes e ajudam a identificar o binario).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PeerLive (Vencord plugin)"
            VALUE "FileDescription", "PeerLive screen audio helper (process loopback, excludes Discord)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "peerlive-audio"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "peerlive-audio.exe"
            VALUE "ProductName", "PeerLive"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
