{
    "name": "telinha",
    "private": true,
    "version": "0.2.3",
    "description": "Stream your screen to friends in the same Discord voice channel, peer to peer, and watch inside Discord (Vencord plugin, add-on loader and Windows installer)",
    "homepage": "https://github.com/HumbertoFernandes7/Telinha#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HumbertoFernandes7/Telinha.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Humberto Fernandes",
    "scripts": {
        "bootstrap": "node scripts/bootstrap.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "lint-styles": "stylelint \"src/**/*.css\"",
        "test": "pnpm test:unit && pnpm test:addon",
        "test:unit": "tsx --tsconfig tsconfig.test.json --import ./test/setup.ts --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
        "test:file": "tsx --tsconfig tsconfig.test.json --import ./test/setup.ts --test",
        "test:addon": "node addon/test/run-all.mjs",
        "test:coverage": "node scripts/coverage.mjs",
        "test:coverage:go": "node scripts/coverage-go.mjs",
        "coverage:check": "node scripts/check-coverage.mjs check",
        "coverage:ratchet": "node scripts/check-coverage.mjs ratchet",
        "build:helper": "native-audio\\build.cmd --copy-to-dist",
        "build:addon": "node addon/build/build-addon.mjs",
        "build:installer": "installer\\build.cmd",
        "check": "pnpm typecheck && pnpm lint && pnpm lint-styles && pnpm test:unit && pnpm build:addon && pnpm test:addon"
    },
    "dependencies": {
        "trystero": "0.26.0"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.14.6",
        "@stylistic/eslint-plugin": "5.10.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "c8": "12.0.0",
        "esbuild": "0.28.1",
        "eslint": "10.6.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-simple-header": "1.2.2",
        "eslint-plugin-simple-import-sort": "13.0.0",
        "eslint-plugin-unused-imports": "4.4.1",
        "fflate": "0.8.3",
        "react": "19.1.10",
        "react-dom": "19.1.10",
        "stylelint": "17.14.0",
        "stylelint-config-standard": "40.0.0",
        "tsx": "4.22.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.62.1"
    },
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=22"
    }
}
